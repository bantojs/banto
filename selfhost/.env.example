# docs/self-hosted-db.md。node selfhost/make-keys.mjs の出力を下に貼り、ドメインを書く。
# このファイル（.env）はリポジトリに入れない。service_role の鍵と JWT_SECRET が入っている

# app: この VPS で Banto も動かす（おすすめ） / api: Banto は Cloudflare Workers
GATEWAY_MODE=app

# お店の URL（Banto の PUBLIC_BASE_URL）
BANTO_URL=https://shop.example.jp
# app のとき: お店のドメイン（この VPS に向けておく。証明書は Caddy が自動で取る）
SHOP_DOMAIN=shop.example.jp
# api のとき: DB の口のドメインと URL（Workers の SUPABASE_URL に書く）
API_DOMAIN=
PUBLIC_API_URL=

# ---- make-keys.mjs の出力 ----
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
AUTHENTICATOR_PASSWORD=
AUTH_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
SESSION_SECRET=
