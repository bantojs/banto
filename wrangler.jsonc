{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "banto",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public: fetch を公開のインターネットと同じ道で出す。無いと、同じ Cloudflare アカウントの
  // 別の Worker（hooks の送信先にした外部プラグインなど）への fetch が error 1042 で届かない（docs/setup.md「うまくいかないとき」）
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // ショップの URL を https://banto.<account>.workers.dev で公開する（独自ドメインは後から追加。docs/custom-domain.md）
  "workers_dev": true,
  "upload_source_maps": true,

  // ログ（Workers Logs）。運営者自身の Cloudflare アカウントに数日だけ残り、開発チームには届かない（テレメトリではない）。
  // ここに書かないと、ダッシュボードで ON にしてもデプロイのたびに OFF に戻る。切るならビルドの変数 BANTO_OBSERVABILITY=off（docs/setup.md §9）
  "observability": { "enabled": true },

  // 設定値はここに書かず、Cloudflare の「変数とシークレット」（または Deploy ボタンの画面）で入れる（docs/env.md）。
  // keep_vars が無いと、ビルドのたびに wrangler が画面で入れた変数を消してしまう。
  "keep_vars": true,

  // R2: 商品画像（MEDIA、公開してよい）と、公開しない置き場（PRIVATE、お問い合わせの添付。カスタムドメインを付けない。docs/inquiries.md）。
  // キーは不要（Binding）。無いバケットは wrangler deploy が作る
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "banto-media" },
    { "binding": "PRIVATE", "bucket_name": "banto-private" }
  ],

  // 在庫予約の期限解放・hooks 配信・メール送信（SchedulerAdapter 経由で呼ぶ）
  "triggers": { "crons": ["*/5 * * * *"] }

  // 必須の 3 つ（SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY）は .dev.vars.example に列挙してあり、Deploy ボタンの画面で入力できる。
  // 決済・通知のプラグイン用（STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, KOMOJU_*, RESEND_API_KEY ほかメールの送り手の値（MAIL_TRANSPORT、docs/email.md）, LINE_CHANNEL_ACCESS_TOKEN）は
  // 有効化するときに「変数とシークレット」で追加する（docs/plugins.md）。
}
